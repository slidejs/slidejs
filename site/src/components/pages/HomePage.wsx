/** @jsxImportSource @wsxjs/wsx-core */

import { LightComponent, autoRegister } from '@wsxjs/wsx-core';
import { i18n } from '@wsxjs/wsx-i18next';
import '@wsxjs/wsx-base-components';
import styles from './HomePage.css?inline';
import '../../components/common/Icon.wsx';

@autoRegister({ tagName: 'home-page' })
@i18n('home')
export class HomePage extends LightComponent {
  constructor() {
    super({
      styles,
      styleName: 'home-page',
    });
  }

  /**
   * 简单的语法高亮函数
   * 注意：需要先处理字符串，避免在字符串内部进行关键字替换
   */
  private highlightCode(code: string): string {
    // 使用占位符保护字符串内容
    const stringPlaceholders: string[] = [];
    let placeholderIndex = 0;

    // 先提取并保护字符串（包括模板字符串）
    let processed = code.replace(/`[\s\S]*?`|"[\s\S]*?"|'[\s\S]*?'/g, (match) => {
      const placeholder = `__STRING_PLACEHOLDER_${placeholderIndex}__`;
      stringPlaceholders[placeholderIndex] = match;
      placeholderIndex++;
      return placeholder;
    });

    // 在非字符串区域进行语法高亮
    // 关键字
    processed = processed.replace(/\b(present|quiz|rules|rule|start|content|slide|text|dynamic|behavior|transition|import|from|const|let|var|function|async|await|return|if|else|for|while|class|extends|interface|type|export|default)\b/g, '<span class="keyword">$1</span>');
    
    // 数字
    processed = processed.replace(/\b(\d+)\b/g, '<span class="number">$1</span>');
    
    // 函数调用（避免匹配关键字）
    processed = processed.replace(/\b([a-zA-Z_$][a-zA-Z0-9_$]*)\s*\(/g, (match, funcName) => {
      // 如果已经是关键字，跳过
      if (match.includes('class="keyword"')) {
        return match;
      }
      return `<span class="function">${funcName}</span>(`;
    });
    
    // 注释（单行）
    processed = processed.replace(/\/\/.*$/gm, '<span class="comment">$&</span>');
    
    // 注释（多行）
    processed = processed.replace(/\/\*[\s\S]*?\*\//g, '<span class="comment">$&</span>');

    // 恢复字符串并添加高亮
    stringPlaceholders.forEach((str, index) => {
      const placeholder = `__STRING_PLACEHOLDER_${index}__`;
      // 为字符串添加高亮类
      const highlighted = str.replace(/^([`"'])([\s\S]*?)\1$/, (match, quote, content) => {
        return `${quote}<span class="string">${content}</span>${quote}`;
      });
      processed = processed.replace(placeholder, highlighted);
    });

    return processed;
  }

  render() {
    return (
      <div class="home-page">
        {/* Hero 区域 */}
        <section class="hero">
          <div class="hero-container">
            <h1 class="hero-title">{this.t('title')}</h1>
            <p class="hero-subtitle">
              {this.t('subtitle')}
            </p>
            <div class="hero-actions">
              <wsx-link to="/docs/guide/getting-started" class="btn btn-primary btn-large">
                {this.t('quickStartCTA', { ns: 'common' })}
              </wsx-link>
              <wsx-link to="/demos" class="btn btn-secondary">
                {this.t('viewDemos', { ns: 'common' })}
              </wsx-link>
            </div>
            {/* 统计数据 */}
            <div class="hero-stats">
              <div class="stat-item">
                <div class="stat-value">MIT</div>
                <div class="stat-label">{this.t('stats.license')}</div>
              </div>
              <div class="stat-item">
                <div class="stat-value">100%</div>
                <div class="stat-label">{this.t('stats.typescript')}</div>
              </div>
              <div class="stat-item">
                <div class="stat-value">0</div>
                <div class="stat-label">{this.t('stats.runtimeDeps')}</div>
              </div>
            </div>
          </div>
        </section>

        {/* 核心特性 */}
        <section class="features">
          <div class="features-container">
            <h2 class="section-title">{this.t('features.title')}</h2>
            <div class="features-grid">
              <div class="feature-card">
                <div class="feature-icon">
                  <wsx-icon name="target" />
                </div>
                <h3 class="feature-title">{this.t('features.multipleTypes.title')}</h3>
                <p class="feature-description">{this.t('features.multipleTypes.description')}</p>
              </div>
              <div class="feature-card">
                <div class="feature-icon">
                  <wsx-icon name="paint" />
                </div>
                <h3 class="feature-title">{this.t('features.modernUI.title')}</h3>
                <p class="feature-description">{this.t('features.modernUI.description')}</p>
              </div>
              <div class="feature-card">
                <div class="feature-icon">
                  <wsx-icon name="plug" />
                </div>
                <h3 class="feature-title">{this.t('features.editorjsIntegration.title')}</h3>
                <p class="feature-description">
                  {this.t('features.editorjsIntegration.description')}
                </p>
              </div>
              <div class="feature-card">
                <div class="feature-icon">
                  <wsx-icon name="package" />
                </div>
                <h3 class="feature-title">{this.t('features.modular.title')}</h3>
                <p class="feature-description">{this.t('features.modular.description')}</p>
              </div>
              <div class="feature-card">
                <div class="feature-icon">
                  <wsx-icon name="lock" />
                </div>
                <h3 class="feature-title">{this.t('features.typeSafe.title')}</h3>
                <p class="feature-description">{this.t('features.typeSafe.description')}</p>
              </div>
              <div class="feature-card">
                <div class="feature-icon">
                  <wsx-icon name="device" />
                </div>
                <h3 class="feature-title">{this.t('features.responsive.title')}</h3>
                <p class="feature-description">{this.t('features.responsive.description')}</p>
              </div>
            </div>
          </div>
        </section>

        {/* 开箱即用 */}
        <section class="ready-out-of-box">
          <div class="ready-container">
            <h2 class="section-title">{this.t('readyOutOfBox.title')}</h2>
            <p class="section-description">{this.t('readyOutOfBox.description')}</p>
            <div class="ready-features">
              <div class="ready-feature">
                <div class="ready-feature-icon">
                  <wsx-icon name="check" />
                </div>
                <span>{this.t('readyOutOfBox.features.drag')}</span>
              </div>
              <div class="ready-feature">
                <div class="ready-feature-icon">
                  <wsx-icon name="check" />
                </div>
                <span>{this.t('readyOutOfBox.features.zoom')}</span>
              </div>
              <div class="ready-feature">
                <div class="ready-feature-icon">
                  <wsx-icon name="check" />
                </div>
                <span>{this.t('readyOutOfBox.features.multiSelect')}</span>
              </div>
              <div class="ready-feature">
                <div class="ready-feature-icon">
                  <wsx-icon name="check" />
                </div>
                <span>{this.t('readyOutOfBox.features.addRemove')}</span>
              </div>
            </div>
            <div class="ready-actions">
              <wsx-link to="/demos" class="btn btn-primary">
                {this.t('viewDemos', { ns: 'common' })}
              </wsx-link>
            </div>
          </div>
        </section>

        {/* 快速开始 */}
        <section class="quick-start">
          <div class="quick-start-container">
            <h2 class="section-title">{this.t('quickStart.title')}</h2>
            <p class="section-description">{this.t('quickStart.description')}</p>
            <div class="code-example">
              <pre>
                <code ref={(el) => {
                  if (el) {
                    el.innerHTML = this.highlightCode(`npm install @slidejs/dsl @slidejs/core @slidejs/runner-revealjs

import { parseSlideDSL, compile } from '@slidejs/dsl';
import { createSlideRunner } from '@slidejs/runner-revealjs';

const dslSource = \`
present quiz "my-quiz" {
  rules {
    rule start "intro" {
      slide {
        content text {
          "Welcome!"
        }
      }
    }
  }
}
\`;

const runner = await createSlideRunner(dslSource, context, {
  container: '#slides'
});`);
                  }
                }} />
              </pre>
            </div>
            <div class="quick-start-actions">
              <wsx-link to="/docs/guide/getting-started" class="btn btn-primary">
                {this.t('viewDocs', { ns: 'common' })}
              </wsx-link>
            </div>
          </div>
        </section>

        {/* 由我们构建，由您设计 */}
        <section class="powered-by">
          <div class="powered-container">
            <h2 class="section-title">{this.t('poweredBy.title')}</h2>
            <p class="section-description">{this.t('poweredBy.description')}</p>
            <div class="powered-actions">
              <wsx-link to="/docs/guide/customization" class="btn btn-primary">
                {this.t('poweredBy.customization')}
              </wsx-link>
            </div>
          </div>
        </section>
      </div>
    );
  }
}
